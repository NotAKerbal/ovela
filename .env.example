# Optional: copy to .env.selfhost before ./ovela up, then edit public origins.
# The launcher generates secrets on first start. Do not commit .env.selfhost.
SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211

# Fresh bundled Immich library, separate from any existing Immich installation.
IMMICH_URL=http://127.0.0.1:2283
IMMICH_PORT=2283
IMMICH_BIND_ADDRESS=127.0.0.1

# Bundled office editor. Use its public HTTPS origin behind a reverse proxy.
COLLABORA_URL=http://127.0.0.1:9980
COLLABORA_PORT=9980
COLLABORA_TLS_TERMINATION=false

# Home mode hides welcome/feedback; allows 20 connections and 10 open documents.
# Set false for higher concurrency with CODE welcome/feedback enabled.
COLLABORA_HOME_MODE=true
